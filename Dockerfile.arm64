# --- Build Stage (on server or local machine) ---
FROM --platform=$BUILDPLATFORM rust:1.78-slim-bookworm AS builder

# Install cross-compilation tools for target arm64 (aarch64)
RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc-aarch64-linux-gnu libc6-dev-arm64-cross pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    PKG_CONFIG_PATH="/usr/lib/aarch64-linux-gnu/pkgconfig"

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo 'fn main(){}' > src/main.rs && \
    rustup target add aarch64-unknown-linux-gnu && \
    cargo build --release --target aarch64-unknown-linux-gnu 2>/dev/null || true && \
    rm -rf src

COPY src ./src
RUN cargo build --release --target aarch64-unknown-linux-gnu --locked

# --- Runtime Stage (ARM64) ---
FROM --platform=linux/arm64 debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -s /bin/false cryptograph

WORKDIR /app
COPY --from=builder /build/target/aarch64-unknown-linux-gnu/release/cryptograph /app/cryptograph
COPY .env.example .env.example

RUN chown -R cryptograph:cryptograph /app
USER cryptograph

ENV RUST_LOG=info
ENTRYPOINT ["/app/cryptograph"]