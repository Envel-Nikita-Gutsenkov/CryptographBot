TELOXIDE_TOKEN=YOUR_BOT_TOKEN_HERE
ALLOWED_ADMIN_IDS=YOUR_TELEGRAM_USER_ID
CMC_API_KEY=YOUR_CMC_API_KEY
COINGECKO_API_KEY=YOUR_COINGECKO_DEMO_KEY
COINCAP_API_KEY=YOUR_COINCAP_PRO_KEY
CRYPTOCOMPARE_API_KEY=xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxx
ANKR_RPC_URL=https://rpc.ankr.com/multichain/xxxxxxx
HELIUS_API_KEY=YOUR_HELIUS_KEY_OR_EMPTY
ALERT_INTERVAL_SECS=300
WALLET_POLL_MINS=15
MAX_RSS_MB=400
HANG_TIMEOUT_SECS=300
RUST_LOG=info
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
COHERE_API_KEY=YOUR_API_KEY
CEREBRAS_API_KEY=YOUR_API_KEY
HF_API_KEY=YOUR_API_KEY
COINSTATS_API_KEY=YOUR_COINSTATS_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
EXA_API_KEY=YOUR_EXA_API_KEY
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
# DeepSeek (paid, OpenAI-compatible). No per-key limits on DeepSeek side,
# so Cryptograph enforces a monthly token/request budget in-code.
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_OR_EMPTY
DEEPSEEK_MONTHLY_TOKEN_BUDGET=3000000
DEEPSEEK_MONTHLY_REQ_BUDGET=150

# SQLite database path (default crypto.db; override to /app/data/crypto.db in Docker)
SQLITE_DB=crypto.db

# Proactive goal worker: hours between market scans (default 6, min 2; halved in volatile markets)
PROACTIVE_SCAN_HOURS=6

# Optional: debug print of AI prompts/drafts/search (1 = on)
CRYPTOGRAPH_DEBUG_PROMPTS=0

# Optional: CoinGecko key fallback used by dev test bins (test_percentages)
CG_API_KEY=
